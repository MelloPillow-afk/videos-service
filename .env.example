DATABASE_URL=postgresql://videos:videos@localhost:5432/videos_dev
TEST_DATABASE_URL=postgresql://videos:videos@localhost:5433/videos_test
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000

# Neon Auth Managed Better Auth. Issuer is the Auth URL origin, not its path.
# Use the deployed provider metadata; leave identity unset for database-free health.
# AUTH_ISSUER=https://ep-example.neonauth.us-east-1.aws.neon.tech
# AUTH_JWKS_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
# AUTH_AUDIENCE=https://ep-example.neonauth.us-east-1.aws.neon.tech
AUTH_SCHEMA=neon_auth
SOURCE_MAX_BYTES=104857600
SOURCE_MAX_DURATION_SECONDS=300
THUMBNAIL_MAX_BYTES=5242880
CDN_ORIGIN=https://media.example.com
