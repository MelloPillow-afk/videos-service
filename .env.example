# Copy to .env for local development. Anything not set here falls back to the defaults
# in src/config.py, which already point at the Docker Compose database and storage.

# Your Neon Auth origin; scripts/get_token.py signs in and prints a token it accepts.
# To skip auth for a quick session, run `AUTH_DISABLED=true make run` instead of setting
# it here: the tests read .env too, and the auth tests expect auth to be on.
AUTH_ISSUER=https://<endpoint>.neonauth.<region>.aws.neon.tech
AUTH_JWKS_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json
AUTH_AUDIENCE=https://<endpoint>.neonauth.<region>.aws.neon.tech

# Trust local storage's HTTPS certificate, which `make local-ca` copies here.
R2_CA_BUNDLE=.local/caddy-root.crt
