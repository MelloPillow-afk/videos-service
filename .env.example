DATABASE_URL=postgresql://videos:videos@localhost:5432/videos_dev
TEST_DATABASE_URL=postgresql://videos:videos@localhost:5433/videos_test
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=5000

# Neon Auth (Managed Better Auth). Issuer and audience are the Auth URL origin.
AUTH_ISSUER=https://ep-example.neonauth.us-east-1.aws.neon.tech
AUTH_JWKS_URL=https://ep-example.neonauth.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
AUTH_AUDIENCE=https://ep-example.neonauth.us-east-1.aws.neon.tech
# Local development only: accept any bearer token as AUTH_DISABLED_SUBJECT.
# AUTH_DISABLED=true
# AUTH_DISABLED_SUBJECT=dev-user

# dev runs workers locally; prod launches the Cloud Run worker job.
API_ENV=dev

# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com, or local MinIO in dev.
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_RAW_BUCKET=videos-raw
# Public origin of the processed bucket; playback and thumbnail URLs start here.
MEDIA_BASE_URL=http://localhost:9000/videos-processed
MAX_UPLOAD_BYTES=104857600
UPLOAD_URL_TTL_SECONDS=900

# Cloud Run worker job, required when API_ENV=prod.
# GCP_PROJECT=pilgrims
# GCP_REGION=us-central1
# WORKER_JOB_NAME=videos-worker
